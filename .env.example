# Put one key in .env.local. If both are set, Claude is used
# unless DOWNSTREAM_PROVIDER=openai.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4.1-mini
# DOWNSTREAM_PROVIDER=anthropic
# DOWNSTREAM_MAX_STORIES=6

# Public origin used in the sitemap, feed, share links, and canonical URLs.
SITE_URL=https://aiboom.news

# GA4 measurement ID for aiboom.news. The tag is omitted when this is empty.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Daily digest. Resend's onboarding address can only mail the account owner
# until aiboom.news is verified in Resend.
# RESEND_API_KEY=
# RESEND_FROM=Downstream <digest@aiboom.news>
